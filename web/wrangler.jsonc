// Cloudflare Workers config for allaboardplanning.com: an assets-only site.
// Cloudflare runs `npm run build` in web/, then `npx wrangler deploy` uploads
// ./dist. Any URL that isn't a file (a lesson someone bookmarked, a refresh
// on /aicp/course) gets index.html, so React Router can show the right page.
{
  "name": "all-aboard-planning",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  // Pull request builds run `npx wrangler preview`, which needs this block.
  // Empty is fine: previews use the same assets and settings as above.
  "previews": {}
}
